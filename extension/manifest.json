{
  "manifest_version": 3,
  "name": "Utopicar",
  "version": "1.2.0",
  "description": "Analyse une annonce auto (texte, photos) ou relève toute une page de résultats Leboncoin, et l'ouvre directement dans Utopicar.",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "https://*.leboncoin.fr/*",
    "https://*.lacentrale.fr/*",
    "https://*.autoscout24.fr/*",
    "https://*.autoscout24.net/*",
    "https://*.leparking.fr/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.leboncoin.fr/*",
        "https://www.lacentrale.fr/*",
        "https://www.autoscout24.fr/*",
        "https://www.leparking.fr/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.utopicar.fr/*",
        "https://utopicar.fr/*",
        "http://localhost:3100/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start"
    }
  ]
}