{
  "manifest_version": 3,
  "name": "UTOPICAR Scanner",
  "version": "1.0.0",
  "description": "Envoie une annonce auto (texte + photos) vers le scanner UTOPICAR en un clic.",
  "permissions": ["clipboardWrite"],
  "host_permissions": [
    "https://*.leboncoin.fr/*",
    "https://*.lacentrale.fr/*",
    "https://*.autoscout24.fr/*",
    "https://*.autoscout24.net/*",
    "https://*.leparking.fr/*",
    "https://*/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://www.leboncoin.fr/*",
      "https://www.lacentrale.fr/*",
      "https://www.autoscout24.fr/*",
      "https://www.leparking.fr/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
