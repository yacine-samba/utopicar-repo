 "lines": [
  {
   "key": "h1",
   "t": 0.1,
   "end": 3.104,
   "text": "Tu en achètes deux, mille de marge chacune : deux mille."
  },
  {
   "key": "h2",
   "t": 3.364,
   "end": 5.371,
   "text": "Ton voisin, lui, compte les jours."
  },
  {
   "key": "deb",
   "t": 5.821,
   "end": 9.023,
   "text": "Deux cartes grises, deux contrôles, deux assurances."
  },
  {
   "key": "part",
   "t": 9.973,
   "end": 11.428,
   "text": "La première part en huit jours."
  },
  {
   "key": "deux2",
   "t": 11.848,
   "end": 12.552,
   "text": "La deuxième…"
  },
  {
   "key": "soupir",
   "t": 12.772,
   "end": 13.289,
   "text": "[soupir]"
  },
  {
   "key": "reste",
   "t": 13.349,
   "end": 13.939,
   "text": "reste."
  },
  {
   "key": "neg",
   "t": 16.339,
   "end": 18.09,
   "text": "Il négocie. Tu acceptes."
  },
  {
   "key": "ben",
   "t": 18.34,
   "end": 20.121,
   "text": "Bénéfice : 120 euros."
  },
  {
   "key": "moins",
   "t": 20.741,
   "end": 21.758,
   "text": "Moins qu'avec une seule."
  },
  {
   "key": "ceux",
   "t": 22.578,
   "end": 24.154,
   "text": "Ceux qui gagnent comptent en jours."
  },
  {
   "key": "prem",
   "t": 24.404,
   "end": 26.379,
   "text": "Ta première : 55 euros par jour."
  },
  {
   "key": "ens",
   "t": 26.599,
   "end": 27.863,
   "text": "Les deux ensemble : 3."
  },
  {
   "key": "verd",
   "t": 28.183,
   "end": 30.126,
   "text": "La deuxième, tu l'achètes au jour 8."
  },
  {
   "key": "proch",
   "t": 30.746,
   "end": 32.201,
   "text": "La prochaine fois que tu te dis…"
  }
 ],
