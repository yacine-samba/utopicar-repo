  {
   "key": "s1",
   "t": 0.1,
   "end": 2.279,
   "text": "Cette voiture a fait fuir tout le monde."
  },
  {
   "key": "s2",
   "t": 2.499,
   "end": 4.82,
   "text": "Cent euros plus tard, elle vaut six cents de plus."
  },
  {
   "key": "ph",
   "t": 5.14,
   "end": 6.617,
   "text": "Phares jaunis : vingt euros."
  },
  {
   "key": "ra",
   "t": 6.837,
   "end": 7.987,
   "text": "Rayure : trente."
  },
  {
   "key": "in",
   "t": 8.187,
   "end": 9.556,
   "text": "Intérieur : cinquante."
  },
  {
   "key": "cqc",
   "t": 10.306,
   "end": 12.162,
   "text": "Ce qui coûte vraiment ne se voit pas."
  },
  {
   "key": "dist",
   "t": 12.542,
   "end": 13.973,
   "text": "La distribution : six cents."
  },
  {
   "key": "fact",
   "t": 14.113,
   "end": 14.976,
   "text": "Demande la facture."
  },
  {
   "key": "emb",
   "t": 15.316,
   "end": 16.519,
   "text": "Embrayage : sept cents."
  },
  {
   "key": "q4",
   "t": 16.619,
   "end": 18.761,
   "text": "En quatrième, plein gaz :"
  },
  {
   "key": "tours",
   "t": 18.841,
   "end": 20.381,
   "text": "les tours montent, pas la vitesse ?"
  },
  {
   "key": "pat",
   "t": 20.621,
   "end": 21.245,
   "text": "Il patine."
  },
  {
   "key": "cul",
   "t": 21.585,
   "end": 23.37,
   "text": "Joint de culasse : mille deux cents."
  },
  {
   "key": "mousse",
   "t": 23.51,
   "end": 24.858,
   "text": "Mousse blanche sous le bouchon d'huile ?"
  },
  {
   "key": "mef",
   "t": 25.148,
   "end": 25.666,
   "text": "Méfiance."
  },
  {
   "key": "parf",
   "t": 26.066,
   "end": 27.269,
   "text": "Et la voiture parfaite ?"
  },
  {
   "key": "perso",
   "t": 27.409,
   "end": 28.862,
   "text": "Personne n'a regardé sous le bouchon."
  }
 ],
