 "lines": [
  {
   "key": "h1",
   "t": 0.1,
   "end": 1.596,
   "text": "11 heures, ton acheteur sonne."
  },
  {
   "key": "h2",
   "t": 1.896,
   "end": 3.104,
   "text": "11 heures 20, tu l'as vendue."
  },
  {
   "key": "h3",
   "t": 3.404,
   "end": 4.883,
   "text": "Ton beau-frère n'y croit pas."
  },
  {
   "key": "pap",
   "t": 5.683,
   "end": 7.574,
   "text": "Il demande les papiers : tu tends la pochette."
  },
  {
   "key": "vir",
   "t": 9.4,
   "end": 10.213,
   "text": "Tu attends le virement."
  },
  {
   "key": "decl",
   "t": 13.4,
   "end": 15.513,
   "text": "Déclaration de vente : 0 euro."
  },
  {
   "key": "paye",
   "t": 15.813,
   "end": 16.869,
   "text": "Ton beau-frère l'a payée."
  },
  {
   "key": "min",
   "t": 18.0,
   "end": 18.661,
   "text": "20 minutes."
  },
  {
   "key": "cafe",
   "t": 19.35,
   "end": 20.509,
   "text": "Ton café est encore chaud."
  },
  {
   "key": "mardi",
   "t": 22.05,
   "end": 23.782,
   "text": "Mardi, tu remplis la pochette."
  },
  {
   "key": "ctrl",
   "t": 24.082,
   "end": 26.747,
   "text": "Contrôle : 2 ans pour rouler, 6 mois pour vendre."
  },
  {
   "key": "tien",
   "t": 27.047,
   "end": 28.638,
   "text": "Le tien a 7 mois : tu le refais."
  },
  {
   "key": "proch",
   "t": 29.2,
   "end": 30.57,
   "text": "La prochaine fois que tu vends…"
  }
 ],
