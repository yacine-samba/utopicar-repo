 "lines": [
  {
   "key": "h1",
   "take": "takeB.mp3",
   "t": 0.1,
   "end": 2.87,
   "text": "Cinq voitures à ne jamais acheter en achat-revente."
  },
  {
   "key": "h2",
   "take": "takeB.mp3",
   "t": 2.95,
   "end": 5.086,
   "text": "Enfin… pas la voiture. Le moteur."
  },
  {
   "key": "n5",
   "take": "takeB.mp3",
   "t": 5.166,
   "end": 8.192,
   "text": "Cinq. BMW 116i : la chaîne s'allonge."
  },
  {
   "key": "n4",
   "take": "fixC.mp3",
   "t": 8.7,
   "end": 11.96,
   "text": "Quatre. Golf 6, 1.4 TSI : chaîne et pistons."
  },
  {
   "key": "n3",
   "take": "takeB.mp3",
   "t": 12.75,
   "end": 15.287,
   "text": "Trois. Le 1.0 EcoBoost : il chauffe."
  },
  {
   "key": "n2",
   "take": "fixC.mp3",
   "t": 15.8,
   "end": 19.157,
   "text": "Deux. Clio 4, 1.2 TCe : il boit son huile."
  },
  {
   "key": "n1",
   "take": "fixC.mp3",
   "t": 19.4,
   "end": 23.446,
   "text": "Et numéro un : le 1.2 PureTech. Sa courroie baigne dans l'huile."
  },
  {
   "key": "six",
   "take": "takeB.mp3",
   "t": 23.526,
   "end": 24.083,
   "text": "Le six ?"
  },
  {
   "key": "meme",
   "take": "takeB.mp3",
   "t": 24.163,
   "end": 26.676,
   "text": "La même 208, courroie changée : cinq cents euros."
  },
  {
   "key": "fuit",
   "take": "takeB.mp3",
   "t": 26.756,
   "end": 27.436,
   "text": "Tout le monde la fuit."
  },
  {
   "key": "toi",
   "take": "takeB.mp3",
   "t": 27.516,
   "end": 28.478,
   "text": "Toi, tu l'achètes."
  }
 ],
