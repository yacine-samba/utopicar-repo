  {
   "key": "h1",
   "t": 0.1,
   "end": 2.87,
   "text": "Cinq voitures à ne jamais acheter en achat-revente."
  },
  {
   "key": "h2",
   "t": 2.95,
   "end": 5.086,
   "text": "Enfin… pas la voiture. Le moteur."
  },
  {
   "key": "n5",
   "t": 5.166,
   "end": 8.192,
   "text": "Cinq. BMW 116i : la chaîne s'allonge."
  },
  {
   "key": "n4",
   "t": 8.7,
   "end": 12.314,
   "text": "Quatre. Golf 6, 1.4 TSI : chaîne et pistons."
  },
  {
   "key": "n3",
   "t": 12.75,
   "end": 15.287,
   "text": "Trois. Le 1.0 EcoBoost : il chauffe."
  },
  {
   "key": "n2",
   "t": 15.8,
   "end": 18.973,
   "text": "Deux. Clio 4, 1.2 TCe : il boit son huile."
  },
  {
   "key": "n1",
   "t": 19.4,
   "end": 23.25,
   "text": "Et numéro un : le 1.2 PureTech. Sa courroie baigne dans l'huile."
  },
  {
   "key": "six",
   "t": 23.33,
   "end": 23.887,
   "text": "Le six ?"
  },
  {
   "key": "meme",
   "t": 23.967,
   "end": 26.112,
   "text": "La même 208, courroie changée : cinq cents euros."
  },
  {
   "key": "fuit",
   "t": 26.75,
   "end": 27.918,
   "text": "Tout le monde la fuit."
  },
  {
   "key": "toi",
   "t": 27.998,
   "end": 28.96,
   "text": "Toi, tu l'achètes."
  }
 ],
